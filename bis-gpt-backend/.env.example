# ==========================================
# BIS-GPT Backend Environment Configuration
# ==========================================

# Application
PROJECT_NAME="BIS-GPT Backend"
APP_ENV="development"
DEBUG=true
API_V1_PREFIX="/api/v1"
SECRET_KEY="super-secret-bis-gpt-signing-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# Database (PostgreSQL with pgvector)
# Local Docker or hosted Postgres instance
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/bis_gpt_db"
SYNC_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bis_gpt_db"

# vLLM / Qwen Inference Endpoint
# Compatible with OpenAI client: vLLM, Ollama, LM Studio or hosted OpenAI API
QWEN_API_BASE_URL="http://localhost:8000/v1"
QWEN_API_KEY="none"
QWEN_MODEL_NAME="Qwen/Qwen2.5-7B-Instruct"
QWEN_MAX_TOKENS=1024
QWEN_TEMPERATURE=0.2

# BGE-M3 Embeddings Service / Local Embedder
# Supports local sentence_transformers or remote embedding microservice
EMBEDDING_MODEL_NAME="BAAI/bge-m3"
EMBEDDING_DIMENSION=1024
EMBEDDING_API_URL=""
USE_MOCK_EMBEDDINGS_FALLBACK=true

# RAG & Retrieval Thresholds
BM25_TOP_K=10
VECTOR_TOP_K=10
RERANK_TOP_K=5
MIN_RELEVANCE_SCORE=0.35

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]
